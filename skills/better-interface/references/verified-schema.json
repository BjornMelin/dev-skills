{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "verification",
    "coverage",
    "confirmed",
    "rejected",
    "degradedCoverage"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "Block",
        "Needs changes",
        "Approve",
        "Inconclusive",
        "No verdict"
      ],
      "description": "\"Approve\" requires every domain to be Clear or judged; use \"Inconclusive\" when any domain is Degraded or Not reviewed. \"No verdict\" only when every lane failed."
    },
    "verification": {
      "type": "array",
      "description": "Every check the lanes ran, carried through verbatim. The report mandates this section, so it cannot be dropped at consolidation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "result",
          "verified"
        ],
        "properties": {
          "check": {
            "type": "string",
            "description": "The exact command or interaction steps."
          },
          "result": {
            "type": "string"
          },
          "verified": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "description": "All six domains, always.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "evidence",
          "result"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "description": "Findings count, \"Clear\", \"Detected only\", \"Not reviewed\", or \"Degraded\"."
          }
        }
      }
    },
    "confirmed": {
      "type": "array",
      "description": "Deduped by root cause, ordered by severity then reach, capped by mode.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "domain",
          "locations",
          "before",
          "after",
          "why"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "domain": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "candidate",
          "rejectedBecause"
        ],
        "properties": {
          "location": {
            "type": "string"
          },
          "candidate": {
            "type": "string"
          },
          "rejectedBecause": {
            "type": "string"
          }
        }
      }
    },
    "degradedCoverage": {
      "type": [
        "string",
        "null"
      ],
      "description": "Named lanes that errored or returned unusable output, or omit when none did."
    }
  }
}
