{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "confirmed", "rejected", "coverage"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["Block", "Needs changes", "Approve", "No verdict"],
      "description": "\"No verdict\" only when every lane failed; a total lane failure must never read as Approve."
    },
    "coverage": {
      "type": "array",
      "description": "All six domains, always.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "evidence", "result"],
        "properties": {
          "domain": { "type": "string" },
          "evidence": { "type": "string" },
          "result": {
            "type": "string",
            "description": "Findings count, \"Clear\", \"Detected only\", \"Not reviewed\", or \"Degraded\"."
          }
        }
      }
    },
    "confirmed": {
      "type": "array",
      "description": "Deduped by root cause, ordered by severity then reach, capped by mode.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "domain", "locations", "before", "after", "why"],
        "properties": {
          "severity": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "domain": { "type": "string" },
          "locations": { "type": "array", "items": { "type": "string" } },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "candidate", "rejectedBecause"],
        "properties": {
          "location": { "type": "string" },
          "candidate": { "type": "string" },
          "rejectedBecause": { "type": "string" }
        }
      }
    },
    "degradedCoverage": {
      "type": "string",
      "description": "Named lanes that errored or returned unusable output, or omit when none did."
    }
  }
}
